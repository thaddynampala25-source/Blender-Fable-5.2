// Cloudflare deployment: the "week2speak" Worker serves the built site (static assets) and the /api/* account backend.
// Deploy with `npm run deploy` (needs CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in the environment).
// One-time setup (see ACCOUNTS_SETUP.md): create the D1 database, put its id below, apply the migrations, set the secrets.
{
  "name": "week2speak",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./w2s-site/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/paid/*"]
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "week2speak", "database_id": "0ed2ac80-682e-4ab1-8989-5ac8eba893dd", "migrations_dir": "./migrations"}
  ],
  "vars": {
    "PLACES_TOTAL": "5",
    "TUTOR_EMAILS": "wamulow@gmail.com",
    "TUTOR_WHATSAPP": "447956095685",
    "CAL_LINK": "https://cal.com/meipb/30min",
    // Stripe Payment Links per price tier (LIVE mode since 20 Nov 2026; account Week2Speak)
    "PAY_LINKS": "{\"gbp\": \"https://buy.stripe.com/00waEZ4Efgrm7DS2TzdQQ00\", \"eur\": \"https://buy.stripe.com/3cI5kFb2DejecYc1PvdQQ06\", \"eur_es\": \"https://buy.stripe.com/3cIcN72w7dfa7DS51HdQQ05\", \"usd\": \"https://buy.stripe.com/cNicN77Qrb724rGgKpdQQ04\", \"usd_latam\": \"https://buy.stripe.com/aFacN7b2D0sogao0LrdQQ03\", \"mxn\": \"https://buy.stripe.com/fZu8wR1s3fniaQ4cu9dQQ02\", \"cop\": \"https://buy.stripe.com/8x24gB0nZgrmaQ41PvdQQ01\"}",
    "SHOW_ANCHOR": "0",
    // anonymous practice counts (metric 3): on since 21 Nov 2026; the privacy notice describes them
    "COUNT_PRACTICE": "1"
  },
  "observability": {"enabled": true}
}
