// Cloudflare deployment: the "week2speak" Worker serves the built site (static assets) and the /api/* account backend.
// Deploy with `npm run deploy` (needs CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in the environment).
// One-time setup (see ACCOUNTS_SETUP.md): create the D1 database, put its id below, apply the migrations, set the secrets.
{
  "name": "week2speak",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./w2s-site/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/paid/*"]
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "week2speak", "database_id": "0ed2ac80-682e-4ab1-8989-5ac8eba893dd", "migrations_dir": "./migrations"}
  ],
  "vars": {
    "PLACES_TOTAL": "5",
    "TUTOR_EMAILS": "",
    "TUTOR_WHATSAPP": "",
    "CAL_LINK": "",
    // Stripe Payment Links per price tier (TEST mode; swap for the live links before launch)
    "PAY_LINKS": "{\"gbp\": \"https://buy.stripe.com/test_00wdR8ekga6bgQ92eSebu00\", \"eur\": \"https://buy.stripe.com/test_5kQ00i8ZW3HN0Rb4n0ebu01\", \"eur_es\": \"https://buy.stripe.com/test_5kQfZg7VSbaf6bv7zcebu02\", \"usd\": \"https://buy.stripe.com/test_cNi7sKfok4LRbvP9Hkebu03\", \"usd_latam\": \"https://buy.stripe.com/test_7sYfZg3FCa6b8jD5r4ebu04\", \"mxn\": \"https://buy.stripe.com/test_7sY28qcc8emr43nf1Eebu05\", \"cop\": \"https://buy.stripe.com/test_9B66oGb84fqv43n6v8ebu06\"}",
    "SHOW_ANCHOR": "0"
  },
  "observability": {"enabled": true}
}
